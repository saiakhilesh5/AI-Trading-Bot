# ===== Application =====
# research | backtest | paper | monitor
TRADING_MODE=paper

# ===== Infrastructure (docker compose defaults) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aits
POSTGRES_USER=aits
POSTGRES_PASSWORD=aits_local_dev
REDIS_URL=redis://localhost:6380/0

# ===== Free data providers =====
# FRED free API key (macro): https://fred.stlouisfed.org/docs/api/api_key/
FRED_API_KEY=
# Alpha Vantage free key (25 req/day): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# GoldPrice.dev free key: https://goldprice.dev
GOLDPRICE_API_KEY=

# ===== LLM (LangChain provider-agnostic: openai | anthropic | gemini | local) =====
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MONTHLY_BUDGET_USD=10

# ===== Paper trading =====
PAPER_STARTING_CAPITAL_USD=100000
